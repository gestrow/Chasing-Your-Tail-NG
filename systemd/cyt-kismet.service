[Unit]
Description=Kismet Wireless Packet Capture for CYT
Documentation=https://github.com/ArgeliusLabs/Chasing-Your-Tail-NG
After=network.target
Wants=network.target

[Service]
Type=forking
# Interface will be substituted by installer
ExecStart=/usr/bin/kismet -c wlan1 --daemonize
ExecStop=/usr/bin/pkill kismet
Restart=on-failure
RestartSec=10
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
